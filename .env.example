# Required for core site data, authentication, and dynamic public sitemap entries.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional integrations. Set only when the corresponding feature is enabled.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_APP_ID=
EBAY_CERT_ID=
GEOAPIFY_API_KEY=
RESEND_API_KEY=
MAILERLITE_API_KEY=

# Scheduled event ingestion remains disabled unless source access is authorized.
CRON_SECRET=
SCD_AUTOMATION_ENABLED=false
